record AnalysisResult {
  label: Text
  mean: Number
  sample_size: Number
}

fn describe(values, label) {
  return AnalysisResult(label: label, mean: average(values), sample_size: count(values))
}

result = describe([10, 20, 30], label: "Sales")
print result
print result.mean

mut current = result
current = current with { label: "Revised", mean: 25 }
# Replacing current does not change result.
print result.mean
print current.mean

# Equality compares values, not construction identity.
unchanged = result with { mean: result.mean }
print result == unchanged
print result != current

# Read a field directly from a function result or updated value.
print describe([2, 4], label: "Preview").mean
print (result with { mean: 30 }).mean

# Records can contain earlier record types.
record Report {
  title: Text
  result: AnalysisResult
}
report = Report("October", result)
revised = report with { result: report.result with { mean: 50 } }
print report.result.mean
print revised.result.mean
print report != revised
