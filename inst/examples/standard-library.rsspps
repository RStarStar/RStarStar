changes = [-9, 0, 16]
magnitudes = std::absolute(changes)
roots = std::square_root(values: magnitudes)
print roots

# Division can produce infinity or an undefined result; the predicate marks both false.
ratios = [10, 1, 0, -1] / [2, 0, 0, 0]
finite_ratios = std::is_finite(values: ratios)
print finite_ratios

codes = ["A", "ABC", ""]
code_lengths = std::text_length(values: codes)
print code_lengths

clean_codes = std::trim_text([" A ", "ABC", "   "])
clean_lengths = std::text_length(clean_codes)
print clean_codes

labels = [" North ", "NORTH", "South"]
normalized_labels = std::lower_text(std::trim_text(labels))
print normalized_labels
